\name{label_log}
\alias{label_log}
\title{Make a single plain-text logarithm label}
\usage{label_log(base = 2, argument = "Fold change")}
\arguments{
  \item{base}{A finite, positive whole-number base.}
  \item{argument}{A non-empty string inside parentheses.}
}
\value{One UTF-8 character string.}
\description{Uses Unicode subscript digits in one string instead of the separate positioned fragments generated by plotmath. The PDF font must support those glyphs.}
\examples{
label_log(2, "Fold change")
ggplot2::labs(x = label_log(2, "Fold change"))
}
